+BUILTIN_TYPES = {'u8', 'u16', 'u32', 'u64', 's8', 's16', 's32', 's64', 'Fix12i', 'size_t',
+                 'Vector3', 'Vector3_16', 'Matrix4x3', 'SharedFilePtr', 'dActor_c', 'fBase_c',
+                 'Player', 'BMD_File', 'KCL_File'}
