diff --git a/port/hal/romimage_rt.cpp b/port/hal/romimage_rt.cpp
new file mode 100644
index 0000000..b14453d
--- /dev/null
+++ b/port/hal/romimage_rt.cpp
@@ -0,0 +1,107 @@
+// Startup fill of the game's ROM-resident globals. See romimage_rt.h.
+#include "romimage_rt.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "romfs.h"
+
+namespace {
+
+struct Image {
+    uint8_t *bytes = nullptr;
+    uint32_t base = 0;
+    size_t len = 0;
+};
+
+inline uint32_t rd32(const uint8_t *p) {
+    return p[0] | p[1] << 8 | p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+// NitroSDK module params: the "21 06 C0 DE DE C0 06 21" magic closes them, and
+// the first three words are the autoload list, its end and the autoload data
+// start (all ARM9 RAM addresses). Each list entry is {address, size, bss}; the
+// blocks' bytes follow one another from the data start. ITCM and DTCM come in
+// this way.
+bool find_autoload(const Image &arm9, uint32_t want_lo, uint32_t want_hi, Image *out) {
+    static const uint8_t magic[8] = {0x21, 0x06, 0xC0, 0xDE, 0xDE, 0xC0, 0x06, 0x21};
+    const size_t scan = arm9.len < 0x8000 ? arm9.len : 0x8000;
+    for (size_t off = 0x1C; off + 8 <= scan; off += 4) {
+        if (memcmp(arm9.bytes + off, magic, 8) != 0) continue;
+        const uint8_t *params = arm9.bytes + off - 0x1C;
+        const uint32_t list = rd32(params), list_end = rd32(params + 4);
+        uint32_t data = rd32(params + 8);
+        if (list < arm9.base || list_end < list || list_end - arm9.base > arm9.len ||
+            (list_end - list) % 12)
+            return false;
+        for (uint32_t e = list; e < list_end; e += 12) {
+            const uint8_t *ent = arm9.bytes + (e - arm9.base);
+            const uint32_t addr = rd32(ent), size = rd32(ent + 4);
+            if (data < arm9.base || data - arm9.base + size > arm9.len) return false;
+            if (addr >= want_lo && addr < want_hi) {
+                out->bytes = arm9.bytes + (data - arm9.base);   // borrowed
+                out->base = addr;
+                out->len = size;
+                return true;
+            }
+            data += size;
+        }
+        return false;
+    }
+    return false;
+}
+
+}  // namespace
+
+extern "C" unsigned sm64ds_romimage_filled = 0, sm64ds_romimage_missing = 0;
+
+extern "C" bool sm64ds_romimage_load(const char *rom_path) {
+    Image arm9;
+    arm9.bytes = romfs::read_arm9(rom_path, &arm9.base, &arm9.len);
+    if (!arm9.bytes) {
+        fprintf(stderr, "romimage: could not read the ARM9\n");
+        return false;
+    }
+    Image itcm, dtcm;
+    const bool have_itcm = find_autoload(arm9, 0x01FF8000u, 0x02000000u, &itcm);
+    const bool have_dtcm = find_autoload(arm9, 0x023C0000u, 0x023C4000u, &dtcm);
+
+    const int MAX_OV = 256;
+    Image *ovs = (Image *)calloc(MAX_OV, sizeof(Image));
+    unsigned filled = 0, missing = 0;
+    for (unsigned i = 0; i < rim_fill_count; ++i) {
+        const RimFill &f = rim_fills[i];
+        Image *img = nullptr;
+        if (f.module == -1) img = &arm9;
+        else if (f.module == -2) img = have_itcm ? &itcm : nullptr;
+        else if (f.module == -3) img = have_dtcm ? &dtcm : nullptr;
+        else if (f.module >= 0 && f.module < MAX_OV) {
+            img = &ovs[f.module];
+            if (!img->bytes && img->base != 0xFFFFFFFFu) {
+                img->bytes = romfs::read_overlay(rom_path, (unsigned)f.module, &img->base, &img->len);
+                if (!img->bytes) img->base = 0xFFFFFFFFu;     // tried, failed
+            }
+            if (!img->bytes) img = nullptr;
+        }
+        if (!img || f.ds_addr < img->base || f.ds_addr - img->base + f.size > img->len) {
+            ++missing;
+            continue;
+        }
+        memcpy(f.dst, img->bytes + (f.ds_addr - img->base), f.size);
+        ++filled;
+    }
+    for (unsigned i = 0; i < rim_patch_count; ++i) {
+        const uint32_t v = (uint32_t)(uintptr_t)rim_patches[i].target;
+        memcpy(rim_patches[i].at, &v, 4);
+    }
+    sm64ds_romimage_filled = filled;
+    sm64ds_romimage_missing = missing;
+    printf("romimage: %u globals filled from the ROM, %u pointers patched", filled, rim_patch_count);
+    if (missing) printf(", %u outside their module image", missing);
+    printf("\n");
+    for (int i = 0; i < MAX_OV; ++i) free(ovs[i].bytes);
+    free(ovs);
+    free(arm9.bytes);
+    return true;
+}
diff --git a/port/hal/romimage_rt.h b/port/hal/romimage_rt.h
new file mode 100644
index 0000000..c51940b
--- /dev/null
+++ b/port/hal/romimage_rt.h
@@ -0,0 +1,41 @@
+// The game's ROM-resident globals on host: fill + pointer patching at startup.
+//
+// port/tools/romimage.py emits storage for every game global that no C source
+// defines (tables, strings, pointer arrays the decomp still keeps as ROM
+// bytes), plus two tables:
+//
+//   rim_fills    which DS range of which module (ARM9, DTCM, overlay N) each
+//                storage holds;
+//   rim_patches  every DS pointer inside that data, as (where in host
+//                storage, host address of what it points to).
+//
+// sm64ds_romimage_load() reads the ARM9 and overlay images from the user's
+// own .nds, copies each fill's bytes, then writes every patch. The tables
+// carry no ROM bytes; the bytes never leave the user's dump.
+#ifndef SM64DS_PORT_ROMIMAGE_RT_H
+#define SM64DS_PORT_ROMIMAGE_RT_H
+
+#include <stdint.h>
+
+/* module: -1 ARM9 main, -2 ITCM, -3 DTCM, >= 0 overlay id */
+struct RimFill {
+    int module;
+    uint32_t ds_addr;
+    uint32_t size;
+    unsigned char *dst;
+};
+struct RimPatch {
+    unsigned char *at;          /* 32-bit slot in host storage */
+    const void *target;         /* host address the DS pointer meant */
+};
+
+extern const RimFill rim_fills[];
+extern const unsigned rim_fill_count;
+extern const RimPatch rim_patches[];
+extern const unsigned rim_patch_count;
+
+/* Fill and patch everything; false (with a message on stderr) if the ROM
+   cannot be read. */
+extern "C" bool sm64ds_romimage_load(const char *rom_path);
+
+#endif
diff --git a/port/ntr/include/ntr/mmio.h b/port/ntr/include/ntr/mmio.h
index e997b21..beb7f1a 100644
--- a/port/ntr/include/ntr/mmio.h
+++ b/port/ntr/include/ntr/mmio.h
@@ -86,6 +86,16 @@ struct Reg {
     Reg &operator|=(T v) { return *this = static_cast<T>(static_cast<T>(*this) | v); }
     Reg &operator&=(T v) { return *this = static_cast<T>(static_cast<T>(*this) & v); }
     Reg &operator^=(T v) { return *this = static_cast<T>(static_cast<T>(*this) ^ v); }
+
+    // `&REG_IME`: game code that keeps a register's address in a plain
+    // `volatile T *` (PXI_InitFifo, the Luigi minigame's IME save) gets the
+    // register's backing word in the host IO block. Accesses through that
+    // pointer read and write the register's storage directly; they do not run
+    // io_write's side effects (the DIV/SQRT engines, IRQ acknowledge), which
+    // none of those sites relies on.
+    volatile T *operator&() const {
+        return reinterpret_cast<volatile T *>(host_ptr(addr));
+    }
 };
 
 }  // namespace ntr
diff --git a/port/tools/hostexterns.py b/port/tools/hostexterns.py
new file mode 100644
index 0000000..d715701
--- /dev/null
+++ b/port/tools/hostexterns.py
@@ -0,0 +1,712 @@
+#!/usr/bin/env python3
+"""Host transform: block-scope `extern` redeclarations that disagree in type.
+
+mwccarm takes each block-scope `extern` declaration on its own terms, so the
+decomp's big TUs (Player.cpp declares a global as `u16` in one method and as
+`char[]` in the next) compile for the DS. GCC treats every block-scope extern
+of a name as the same entity across the translation unit and rejects the
+second type: "conflicting declaration". The source is byte-matched and must
+not change, so the port transforms its HOST COPY instead, as tools/hostgen.py
+does for MMIO:
+
+  each block-scope declaration whose type disagrees with an earlier one gets a
+  private C++ name bound to the SAME linker symbol through an asm label --
+      extern char data_0209f49c[];
+  becomes
+      extern char data_0209f49c__h2[] __asm__("data_0209f49c");
+  and the name is rewritten from there to the end of the enclosing block.
+
+Only data and extern "C" functions conflict this way (C++ functions overload
+instead), and both link by their plain name, so the asm label is exact.
+
+  hostexterns.py --check FILE...      print the files that need the transform
+  hostexterns.py IN OUT               write the transformed copy
+"""
+import collections
+import re
+import sys
+
+DECL = re.compile(r'^(\s*)extern\s+(?!"C")(.*?);\s*(//.*|/\*.*\*/\s*)?$')
+IDENT = re.compile(r'[A-Za-z_]\w*')
+KEYWORDS = {'const', 'volatile', 'unsigned', 'signed', 'struct', 'union', 'enum',
+            'int', 'char', 'short', 'long', 'void', 'float', 'double', 'bool'}
+
+
+def declared_name(body):
+    """The declarator name in `TYPE NAME[...]`, `TYPE NAME(...)`, `TYPE (*NAME)(...)`."""
+    b = re.sub(r'__attribute__\s*\(\(.*?\)\)', '', body)
+    b = b.split('=')[0]
+    # function pointer / pointer-to-array: (*NAME) or (&NAME)
+    m = re.search(r'\(\s*[*&]\s*(?:const\s+)?([A-Za-z_]\w*)\s*\)', b)
+    if m:
+        return m.group(1), m.start(1), m.end(1)
+    # the last identifier before the first '(' or '[' (or the end)
+    cut = len(b)
+    for ch in '([':
+        i = b.find(ch)
+        if i != -1:
+            cut = min(cut, i)
+    ids = [(mm.group(0), mm.start(), mm.end()) for mm in IDENT.finditer(b[:cut])]
+    ids = [x for x in ids if x[0] not in KEYWORDS]
+    return ids[-1] if ids else None
+
+
+def normalize(body, name):
+    return re.sub(r'\s+', ' ', re.sub(r'\b%s\b' % re.escape(name), '@', body)).strip()
+
+
+def strip_code(line):
+    """The line with strings, chars and comments blanked (for brace counting).
+    Comments are handled before quotes, so the apostrophe in
+    `/* this TU's */` is prose, not a char literal. An unterminated `/*`
+    blanks the rest of the line (see unterminated_comment)."""
+    out, i, n = [], 0, len(line)
+    while i < n:
+        c = line[i]
+        if line.startswith('//', i):
+            break
+        if line.startswith('/*', i):
+            j = line.find('*/', i + 2)
+            if j == -1:
+                break
+            out.append(' ')
+            i = j + 2
+            continue
+        if c in '"\'':
+            q = c; out.append(' '); i += 1
+            while i < n and line[i] != q:
+                i += 2 if line[i] == '\\' else 1
+            i += 1
+            continue
+        out.append(c); i += 1
+    return ''.join(out)
+
+
+def unterminated_comment(line):
+    """True when the line opens a /* comment it does not close."""
+    i, n = 0, len(line)
+    while i < n:
+        if line.startswith('//', i):
+            return False
+        if line.startswith('/*', i):
+            j = line.find('*/', i + 2)
+            if j == -1:
+                return True
+            i = j + 2
+            continue
+        if line[i] in '"\'':
+            q = line[i]; i += 1
+            while i < n and line[i] != q:
+                i += 2 if line[i] == '\\' else 1
+            i += 1
+            continue
+        i += 1
+    return False
+
