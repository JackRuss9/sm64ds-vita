+#elif defined(NTR_THREAD_FIBERS)
+// One turn token. `turn` says whose turn it is; each side waits for its own.
+enum Turn { HOST, GAME };
+// Initialised by function, not PTHREAD_*_INITIALIZER: not every embedded
+// pthread provides the static initialisers.
+pthread_mutex_t g_lock;
+pthread_cond_t g_cv;
+bool g_sync_ready = false;
+Turn g_turn = HOST;
+bool g_abandon = false;           // host stopped early: the game thread must exit
+
+void give_turn(Turn to) {         // caller holds g_lock
+    g_turn = to;
+    pthread_cond_broadcast(&g_cv);
+}
+void wait_turn(Turn mine) {       // caller holds g_lock
+    while (g_turn != mine) pthread_cond_wait(&g_cv, &g_lock);
 }
 
-// Stack size for the game fiber: the Windows build's 256 KB.
-constexpr size_t GAME_STACK = 256 * 1024;
-
-// Prime a fresh stack so ntr_ctx_switch's restore half lands in `entry`:
-// [d8-d15][r4-r12][pc], lowest address first, 8-byte aligned top.
-void *prime_stack(void *stack, size_t size, void (*entry)()) {
-    uintptr_t top = (reinterpret_cast<uintptr_t>(stack) + size) & ~uintptr_t(7);
-    uint32_t *sp = reinterpret_cast<uint32_t *>(top) - 26;   // 16 + 9 + 1 words
-    for (int i = 0; i < 25; ++i) sp[i] = 0;
-    sp[25] = static_cast<uint32_t>(reinterpret_cast<uintptr_t>(entry));
-    return sp;
+void *game_thread(void *) {
+    pthread_mutex_lock(&g_lock);
+    wait_turn(GAME);
+    pthread_mutex_unlock(&g_lock);
+    if (!g_abandon) g.entry();
+    pthread_mutex_lock(&g_lock);
+    g.game_done = true;
+    give_turn(HOST);
+    pthread_mutex_unlock(&g_lock);
+    return nullptr;
 }
+
+// The game thread's stack: generous, the Windows fiber had 256 KB.
+constexpr size_t GAME_STACK = 1024 * 1024;
 #endif
 
