-//   ntr_ctx_switch(&save_sp, new_sp)
-//
-// The two VFP instructions are spelled as raw encodings (.inst) on purpose: a
-// `.fpu' directive here would change the assembler's FPU for the REST of the
-// translation unit and reject the NEON code the compiler emits after it.
-//
-// A new stack is primed with the same frame layout, its return address being
-// the fiber's entry function, so the first switch "returns" into it.
+// Why a real thread and not a hand-rolled stack switch: on the PS Vita a
+// switch onto a malloc'd stack ran the game for eight frames and was then
+// stopped by the kernel (stop reason 0x10006) with sp outside the thread's
+// registered stack. A thread gives the game a stack the kernel itself created.
+// VitaSDK's pthread (pthread-embedded) creates native SceKernel threads.
 // ---------------------------------------------------------------------------
-#if !defined(_WIN32) && defined(__arm__)
-#define NTR_ARM_FIBERS 1
-extern "C" void ntr_ctx_switch(void **save_sp, void *new_sp);
-__asm__(
-    "   .text\n"
-    "   .syntax unified\n"
-    "   .arm\n"
-    "   .align 2\n"
-    "   .global ntr_ctx_switch\n"
-    "   .type ntr_ctx_switch, %function\n"
-    "ntr_ctx_switch:\n"
-    "   push  {r4-r12, lr}\n"     /* 40 bytes */
-    "   .inst 0xed2d8b10\n"       /* vpush {d8-d15}: 64 bytes, 104 total, 8-aligned */
-    "   str   sp, [r0]\n"
-    "   mov   sp, r1\n"
-    "   .inst 0xecbd8b10\n"       /* vpop {d8-d15} */
-    "   pop   {r4-r12, pc}\n"     /* interworking return (ARMv7) */
-    "   .size ntr_ctx_switch, .-ntr_ctx_switch\n");
+#if !defined(_WIN32)
+#define NTR_THREAD_FIBERS 1
+#include <pthread.h>
 #endif
 
