diff --git a/port/ntr/rt.cpp b/port/ntr/rt.cpp
index 0e72452..fed3114 100644
--- a/port/ntr/rt.cpp
+++ b/port/ntr/rt.cpp
@@ -3,12 +3,52 @@
 #include "ntr/mmio.h"
 
 #include <cstdio>
+#include <cstdlib>
 
 #if defined(_WIN32)
 #define WIN32_LEAN_AND_MEAN
 #include <windows.h>
 #endif
 
+// ---------------------------------------------------------------------------
+// Fibers without an OS (PS Vita, and ARM Linux under QEMU for testing).
+//
+// Windows has CreateFiber/SwitchToFiber. Elsewhere the same two-stack, one-at-
+// a-time model is a handful of ARM instructions: save the registers the AAPCS
+// says a callee must preserve (r4-r11, plus r12 to keep the frame 8-byte
+// aligned, lr as the resume address, and VFP d8-d15), store sp, load the other
+// stack's sp, restore, return into it. Exactly one fiber runs at any time, so
+// nothing races, and no OS threads or semaphores are involved.
+//
+//   ntr_ctx_switch(&save_sp, new_sp)
+//
+// The two VFP instructions are spelled as raw encodings (.inst) on purpose: a
+// `.fpu' directive here would change the assembler's FPU for the REST of the
+// translation unit and reject the NEON code the compiler emits after it.
+//
+// A new stack is primed with the same frame layout, its return address being
+// the fiber's entry function, so the first switch "returns" into it.
+// ---------------------------------------------------------------------------
+#if !defined(_WIN32) && defined(__arm__)
+#define NTR_ARM_FIBERS 1
+extern "C" void ntr_ctx_switch(void **save_sp, void *new_sp);
+__asm__(
+    "   .text\n"
+    "   .syntax unified\n"
+    "   .arm\n"
+    "   .align 2\n"
+    "   .global ntr_ctx_switch\n"
+    "   .type ntr_ctx_switch, %function\n"
+    "ntr_ctx_switch:\n"
+    "   push  {r4-r12, lr}\n"     /* 40 bytes */
+    "   .inst 0xed2d8b10\n"       /* vpush {d8-d15}: 64 bytes, 104 total, 8-aligned */
+    "   str   sp, [r0]\n"
+    "   mov   sp, r1\n"
+    "   .inst 0xecbd8b10\n"       /* vpop {d8-d15} */
+    "   pop   {r4-r12, pc}\n"     /* interworking return (ARMv7) */
+    "   .size ntr_ctx_switch, .-ntr_ctx_switch\n");
+#endif
+
 namespace ntr {
 namespace {
 
@@ -25,8 +65,9 @@ inline volatile uint16_t &reg16(uint32_t a) {
 }
 
 struct Runtime {
-    void *host_fiber = nullptr;
+    void *host_fiber = nullptr;   // Windows: fiber handles; ARM: saved stack pointers
     void *game_fiber = nullptr;
+    void *game_stack = nullptr;   // ARM: the game fiber's allocated stack
     void (*entry)() = nullptr;
     FrameHook hook = nullptr;
     uint64_t frame = 0;
@@ -45,6 +86,25 @@ void CALLBACK game_trampoline(void *) {
     // The game returned. Hand control back for good.
     for (;;) SwitchToFiber(g.host_fiber);
 }
+#elif defined(NTR_ARM_FIBERS)
+void game_trampoline() {
+    g.entry();
+    g.game_done = true;
+    for (;;) ntr_ctx_switch(&g.game_fiber, g.host_fiber);
+}
+
+// Stack size for the game fiber: the Windows build's 256 KB.
+constexpr size_t GAME_STACK = 256 * 1024;
+
+// Prime a fresh stack so ntr_ctx_switch's restore half lands in `entry`:
+// [d8-d15][r4-r12][pc], lowest address first, 8-byte aligned top.
+void *prime_stack(void *stack, size_t size, void (*entry)()) {
+    uintptr_t top = (reinterpret_cast<uintptr_t>(stack) + size) & ~uintptr_t(7);
+    uint32_t *sp = reinterpret_cast<uint32_t *>(top) - 26;   // 16 + 9 + 1 words
+    for (int i = 0; i < 25; ++i) sp[i] = 0;
+    sp[25] = static_cast<uint32_t>(reinterpret_cast<uintptr_t>(entry));
+    return sp;
+}
 #endif
 
 // Advance the scanline counter across a frame. Anything spinning on VCOUNT --
@@ -60,6 +120,10 @@ void rt_vblank_wait() {
     if (!g.game_fiber) return;   // not running under rt_run; nothing to yield to
     reg32(REG_IF) |= IRQ_VBLANK;
     SwitchToFiber(g.host_fiber);
+#elif defined(NTR_ARM_FIBERS)
+    if (!g.game_stack) return;   // not running under rt_run; nothing to yield to
+    reg32(REG_IF) |= IRQ_VBLANK;
+    ntr_ctx_switch(&g.game_fiber, g.host_fiber);
 #endif
 }
 
@@ -86,9 +150,44 @@ uint32_t rt_irq_restore(uint32_t prev) {
 bool rt_irq_masked() { return g.cpsr_i != 0; }
 
 uint64_t rt_run(void (*game)(), FrameHook hook, uint64_t max_frames) {
-#if !defined(_WIN32)
+#if defined(NTR_ARM_FIBERS)
+    if (!io_init()) {
+        std::fprintf(stderr, "rt_run: io_init failed\n");
+        return 0;
+    }
+    g = Runtime{};
+    g.entry = game;
+    g.hook = hook;
+    g.max_frames = max_frames;
+    g.game_stack = std::malloc(GAME_STACK);
+    if (!g.game_stack) {
+        std::fprintf(stderr, "rt_run: cannot allocate the game fiber's stack\n");
+        return 0;
+    }
+    g.game_fiber = prime_stack(g.game_stack, GAME_STACK, game_trampoline);
+
+    reg32(REG_IME) = 1;
+    reg32(REG_IE) = IRQ_VBLANK;
+
+    while (!g.game_done && !g.stop) {
+        ntr_ctx_switch(&g.host_fiber, g.game_fiber);   // run until the game blocks
+        if (g.game_done) break;
+
+        run_scanlines();
+        ++g.frame;
+        if (g.hook && !g.hook(g.frame)) g.stop = true;
+        if (g.max_frames && g.frame >= g.max_frames) g.stop = true;
+        reg32(REG_IF) &= ~IRQ_VBLANK;
+    }
+    // A stopped (not finished) game fiber is simply abandoned, as DeleteFiber
+    // does on Windows: its stack goes away with it.
+    std::free(g.game_stack);
+    g.game_stack = nullptr;
+    g.game_fiber = nullptr;
+    return g.frame;
+#elif !defined(_WIN32)
     (void)game; (void)hook; (void)max_frames;
-    std::fprintf(stderr, "rt_run: fiber backend is Windows-only so far\n");
+    std::fprintf(stderr, "rt_run: no fiber backend for this host\n");
     return 0;
 #else
     if (!io_init()) {
