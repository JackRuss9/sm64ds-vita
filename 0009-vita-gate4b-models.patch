+def emit_vita_loader(out_path):
+    """--vita-loader OUT: the console build reads these tables from the user's
+    ROM at startup (port/hal/romdata_rom.cpp), so no Nintendo bytes exist at
+    build time either. Emit the same symbols as zero-filled storage plus a
+    descriptor table the loader fills them from. TABLES stays the one list."""
+    lines = ["// GENERATED by port/tools/romdata.py --vita-loader. Storage for the",
+             "// ROM constants; port/hal/romdata_rom.cpp fills it from the ROM's ARM9.",
+             "#include <stddef.h>", "#include <stdint.h>",
+             '#include "romdata_rom.h"', "", 'extern "C" {']
+    entries = []
+    for addr, length, ctype, *rest in TABLES:
+        name = f"data_{addr:08x}"
+        width = 4 if ctype == "int" else (2 if ctype == "short" else 1)
+        lines.append(f"__attribute__((aligned(4))) {ctype} {name}[{length // width}];")
+        for alias in (rest[0] if rest else []):
+            lines.append(f'extern {ctype} {alias}[{length // width}] '
+                         f'__attribute__((alias("{name}")));')
+        entries.append(f"    {{0x{addr:08x}u, {length}u, {name}}},")
+    lines += ["}", "", "const RomdataTable sm64ds_romdata_tables[] = {", *entries, "};",
+              f"const size_t sm64ds_romdata_count = {len(TABLES)};",
+              f"const uint32_t sm64ds_romdata_bss_start = 0x{BSS_START:08x}u;", ""]
+    out_path.parent.mkdir(parents=True, exist_ok=True)
+    out_path.write_text("\n".join(lines), encoding="ascii")
+    print(f"romdata (vita loader) -> {out_path}")
+
+
 def main():
