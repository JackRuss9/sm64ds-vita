diff --git a/port/hal/romdata_rom.cpp b/port/hal/romdata_rom.cpp
new file mode 100644
index 0000000..eb82513
--- /dev/null
+++ b/port/hal/romdata_rom.cpp
@@ -0,0 +1,58 @@
+// Fill the ROM-constant tables from the ARM9 inside the user's .nds.
+// See romdata_rom.h. Same facts and same anchor check as port/tools/romdata.py,
+// which reads them from extracted/arm9_dec.bin on PC.
+#include "romdata_rom.h"
+
+#include "romfs.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifndef SM64DS_ROM_PATH
+#define SM64DS_ROM_PATH "ux0:data/sm64ds/sm64ds.nds"
+#endif
+
+namespace {
+// romdata.py's anchor: Copy36Bytes starts with `ldmia r0!, {r2, r3, ip}` here.
+constexpr uint32_t ANCHOR_ADDR = 0x0205A548u;
+const uint8_t ANCHOR_BYTES[4] = {0x0c, 0x10, 0xb0, 0xe8};
+}  // namespace
+
+bool sm64ds_romdata_load(const char *rom_path) {
+    if (!rom_path) rom_path = getenv("SM64DS_ROM");
+    if (!rom_path) rom_path = SM64DS_ROM_PATH;
+    uint32_t base = 0;
+    size_t len = 0;
+    uint8_t *arm9 = romfs::read_arm9(rom_path, &base, &len);
+    if (!arm9) {
+        fprintf(stderr, "romdata: could not read the ARM9 from %s\n", rom_path);
+        return false;
+    }
+    bool ok = true;
+    if (ANCHOR_ADDR < base || ANCHOR_ADDR - base + 4 > len ||
+        memcmp(arm9 + (ANCHOR_ADDR - base), ANCHOR_BYTES, 4) != 0) {
+        fprintf(stderr, "romdata: ARM9 failed the Copy36Bytes anchor at 0x%08x "
+                        "(wrong game or region?)\n", (unsigned)ANCHOR_ADDR);
+        ok = false;
+    }
+    for (size_t i = 0; ok && i < sm64ds_romdata_count; ++i) {
+        const RomdataTable &t = sm64ds_romdata_tables[i];
+        if (t.addr < base || t.addr + t.length > sm64ds_romdata_bss_start ||
+            t.addr - base + t.length > len) {
+            fprintf(stderr, "romdata: table 0x%08x+0x%x is outside the ARM9 image\n",
+                    (unsigned)t.addr, (unsigned)t.length);
+            ok = false;
+            break;
+        }
+        memcpy(t.storage, arm9 + (t.addr - base), t.length);
+    }
+    free(arm9);
+    return ok;
+}
+
+// The launcher's pre-test hook (port/vita/vita_main.cpp): the tables must be in
+// place before any game code runs.
+extern "C" bool sm64ds_vita_preinit(void) {
+    return sm64ds_romdata_load(nullptr);
+}
diff --git a/port/hal/romdata_rom.h b/port/hal/romdata_rom.h
new file mode 100644
index 0000000..3a7bbab
--- /dev/null
+++ b/port/hal/romdata_rom.h
@@ -0,0 +1,25 @@
+// ROM constants (sine table, default matrices, OBJ size tables) for console
+// builds: zero-filled storage generated by `port/tools/romdata.py
+// --vita-loader`, filled at startup from the ARM9 inside the user's ROM. The
+// PC build keeps romdata.py's generated initialized arrays instead.
+#ifndef SM64DS_PORT_ROMDATA_ROM_H
+#define SM64DS_PORT_ROMDATA_ROM_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+struct RomdataTable {
+    uint32_t addr;     // ARM9 address of the table in the retail image
+    uint32_t length;   // bytes
+    void *storage;     // the host symbol game code links against
+};
+
+extern const RomdataTable sm64ds_romdata_tables[];
+extern const size_t sm64ds_romdata_count;
+extern const uint32_t sm64ds_romdata_bss_start;
+
+// Fill every table from the ROM. false (with a message on stderr) if the ROM
+// is missing or its ARM9 is not the image the tables were taken from.
+bool sm64ds_romdata_load(const char *rom_path);
+
+#endif
diff --git a/port/hal/romfs.cpp b/port/hal/romfs.cpp
index 2cfae80..c76d7a3 100644
--- a/port/hal/romfs.cpp
+++ b/port/hal/romfs.cpp
@@ -260,6 +260,40 @@ bool open(const char *rom_path,
     return ok;
 }
 
+uint8_t *read_arm9(const char *rom_path, uint32_t *ram_base, size_t *len) {
+    FILE *f = fopen(rom_path, "rb");
+    if (!f) return nullptr;
+    uint8_t hdr[0x30];
+    if (fread(hdr, 1, sizeof hdr, f) != sizeof hdr) { fclose(f); return nullptr; }
+    // GBATEK header: 0x20 ARM9 ROM offset, 0x28 RAM address, 0x2C size.
+    const uint32_t off = rd32(hdr + 0x20), ram = rd32(hdr + 0x28), size = rd32(hdr + 0x2C);
+    uint8_t *raw = (size >= 8 && size < (64u << 20)) ? (uint8_t *)malloc(size) : nullptr;
+    if (!raw || fseek(f, (long)off, SEEK_SET) != 0 || fread(raw, 1, size, f) != size) {
+        free(raw); fclose(f); return nullptr;
+    }
+    fclose(f);
+    // Like ndspy's code decompression: the BLZ footer may be followed by up to
+    // 0x1C bytes of appended data. Take the first plausible footer position.
+    size_t stream = 0;
+    for (size_t extra = 0; extra < 0x20 && extra + 8 <= size; extra += 4) {
+        const uint32_t word = rd32(raw + size - extra - 8);
+        const uint32_t hdr_len = word >> 24, enc_len = word & 0xFFFFFF;
+        if (hdr_len < 8 || enc_len > size) continue;
+        stream = size - extra;
+        break;
+    }
+    uint8_t *out = nullptr;
+    if (stream) {
+        out = blz_decompress(raw, stream, len);
+        free(raw);
+    } else {               // no footer at all: stored uncompressed
+        out = raw;
+        *len = size;
+    }
+    if (out) *ram_base = ram;
+    return out;
+}
+
 uint8_t *read_file(unsigned file_id, size_t *size) {
     if (!g_rom || file_id >= g_file_count) return nullptr;
     const uint32_t start = rd32(g_fat + file_id * 8), end = rd32(g_fat + file_id * 8 + 4);
